# OpenAI Agents SDK
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
AI_PET_MODEL_API=responses
OPENAI_BASE_URL=
OPENAI_WEBSOCKET_BASE_URL=

# External MCP servers are configured in mcp/servers.json.
# Keep API keys in env vars and reference them from JSON with api_key_env or ${ENV_NAME}.
AI_PET_MCP_ENABLED=true
AI_PET_MCP_CONNECT_TIMEOUT=15
AI_PET_MCP_CLEANUP_TIMEOUT=15
DASHSCOPE_API_KEY=

# Python agent service
AI_PET_AGENT_HOST=127.0.0.1
AI_PET_AGENT_PORT=8787

# SDK session memory
AI_PET_SESSION_ID=desktop-active
AI_PET_SESSION_DB_PATH=
AI_PET_SESSION_CONTEXT_LIMIT=40

# Markdown memory + skills
AI_PET_MEMORY_ENABLED=true
AI_PET_MEMORY_AUTO_CAPTURE=true
AI_PET_MEMORY_DIR=

# Injection limits (max chars loaded into one model request)
AI_PET_MEMORY_CORE_CHAR_LIMIT=3000
AI_PET_MEMORY_MODE_CHAR_LIMIT=2500
AI_PET_SKILL_INDEX_CHAR_LIMIT=2000
AI_PET_SKILL_FILE_CHAR_LIMIT=5000
AI_PET_MAX_SKILLS_PER_REQUEST=2

# Storage limits (max chars kept per markdown file)
AI_PET_MEMORY_CORE_FILE_MAX_CHARS=12000
AI_PET_MEMORY_MODE_FILE_MAX_CHARS=10000
AI_PET_SKILL_FILE_MAX_CHARS=14000
AI_PET_SKILL_INDEX_FILE_MAX_CHARS=12000

# Local knowledge base (LightRAG-like, no external LightRAG dependency)
AI_PET_KB_ENABLED=true
AI_PET_KB_DIR=
AI_PET_KB_DOCUMENT_DIR=
AI_PET_KB_INDEX_DB_PATH=
AI_PET_KB_TOP_K=5
AI_PET_KB_MAX_CONTEXT_CHARS=6000
AI_PET_KB_CHUNK_MAX_CHARS=1400
AI_PET_KB_AUTO_IMPORT_ON_QUERY=true
AI_PET_KB_IMPORT_ON_STARTUP=true

# Knowledge file upload + MarkItDown conversion
AI_PET_KB_UPLOAD_ENABLED=true
AI_PET_KB_UPLOAD_DIR=
AI_PET_KB_CONVERTED_DIR=
AI_PET_KB_UPLOAD_MAX_MB=25
AI_PET_KB_UPLOAD_ALLOWED_EXTENSIONS=.md,.txt,.pdf,.docx,.pptx,.xlsx,.html,.htm,.csv,.json

# Knowledge embedding search (OpenAI-compatible, optional)
AI_PET_KB_EMBEDDING_ENABLED=true
AI_PET_KB_EMBEDDING_MODEL=text-embedding-v3
AI_PET_KB_EMBEDDING_API_KEY=
AI_PET_KB_EMBEDDING_BASE_URL=
AI_PET_KB_EMBEDDING_DIMENSIONS=
AI_PET_KB_VECTOR_WEIGHT=0.55
AI_PET_KB_KEYWORD_WEIGHT=0.45

# Knowledge graph search (rule-based, optional)
AI_PET_KB_GRAPH_ENABLED=true
AI_PET_KB_GRAPH_MAX_RELATIONS_PER_CHUNK=8
AI_PET_KB_GRAPH_WEIGHT=0.20
AI_PET_KB_GRAPH_CONTEXT_LIMIT=2000

# Knowledge graph LLM extraction (LightRAG-inspired, optional)
AI_PET_KB_GRAPH_LLM_ENABLED=false
AI_PET_KB_GRAPH_EXTRACTOR=hybrid
AI_PET_KB_GRAPH_LLM_MODEL=
AI_PET_KB_GRAPH_LLM_API_KEY=
AI_PET_KB_GRAPH_LLM_BASE_URL=
AI_PET_KB_GRAPH_LLM_MAX_ENTITIES_PER_CHUNK=30
AI_PET_KB_GRAPH_LLM_MAX_RELATIONS_PER_CHUNK=20
AI_PET_KB_GRAPH_LLM_MIN_CONFIDENCE=0.65
AI_PET_KB_GRAPH_LLM_MAX_CHARS=3000
AI_PET_KB_GRAPH_LLM_FALLBACK_TO_RULE=true

# Global retrieval document summaries (LightRAG-inspired, optional)
AI_PET_KB_SUMMARY_ENABLED=true
AI_PET_KB_SUMMARY_LLM_ENABLED=false
AI_PET_KB_SUMMARY_MODEL=
AI_PET_KB_SUMMARY_API_KEY=
AI_PET_KB_SUMMARY_BASE_URL=
AI_PET_KB_SUMMARY_MAX_CHARS=6000
AI_PET_KB_SUMMARY_ON_IMPORT=true
AI_PET_KB_SUMMARY_EMBEDDING_ENABLED=true
