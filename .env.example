# =============================================================================
# AI Pet 环境变量示例
# =============================================================================
# 使用方式：
# 1. 将本文件复制为项目根目录下的 .env。
# 2. 按需填写 API Key、模型、端口和本地路径。
# 3. 修改后需要重启 Python 后端（npm run dev:python）才会生效。
#
# 注意：
# - .env.example 是示例文件，可以提交到仓库；真实 .env 不要提交。
# - 路径为空时，程序会使用代码里的默认目录。
# - 布尔值统一使用 true / false。
# - JSON 类型变量必须是单行合法 JSON。


# =============================================================================
# 1. 模型与 OpenAI Agents SDK
# =============================================================================

# 模型服务 API Key。
# OpenAI：填 OpenAI Key。
# DeepSeek：填 DeepSeek Key。
# 阿里云百炼 DashScope 兼容模式：填 DashScope Key。
OPENAI_API_KEY=

# 主对话模型名。
# OpenAI 示例：gpt-5.4
# DeepSeek 示例：deepseek-v4-flash
# 阿里云百炼示例：qwen3-max
OPENAI_MODEL=gpt-5.4

# 模型 API 类型。
# responses：使用 OpenAI Responses API，适合 OpenAI 官方模型。
# chat_completions：使用 OpenAI Chat Completions 兼容接口，适合 DeepSeek、百炼兼容模式等。
AI_PET_MODEL_API=responses

# OpenAI 兼容接口 Base URL。
# OpenAI 官方通常留空。
# DeepSeek 示例：https://api.deepseek.com
# 阿里云百炼兼容模式示例：https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# Responses WebSocket Base URL，通常留空。
# 仅当你明确使用需要 WebSocket 的 OpenAI Responses 能力时再配置。
OPENAI_WEBSOCKET_BASE_URL=

# 传给模型接口的额外请求体，必须是单行 JSON 对象。
# 通常留空。
# DeepSeek + chat_completions 默认会自动使用 {"thinking":{"type":"disabled"}}，
# 因为 DeepSeek thinking 模式下的工具调用要求回传 reasoning_content，
# 当前 Agents SDK 链路更适合关闭 thinking 来稳定使用工具。
# 如需手动覆盖，可填：
# AI_PET_MODEL_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
AI_PET_MODEL_EXTRA_BODY_JSON=

# Chat Completions 跨轮历史兼容模式。
# auto：推荐。DeepSeek 自动使用 text_only，其它提供商使用 full。
# full：保留原始 SDK session 历史，包括工具调用过程。
# text_only：跨轮只保留 user / assistant 文本，丢弃历史工具调用内部项。
# 说明：DeepSeek 对 tool / tool_calls / reasoning_content 的历史格式很严格，
# 因此默认在 DeepSeek 上使用 text_only 以避免 400。
AI_PET_CHAT_COMPLETIONS_HISTORY_MODE=auto


# =============================================================================
# 2. MCP 外部工具服务
# =============================================================================

# 是否启用 MCP 服务。
# MCP 服务列表不在环境变量里配置，而是在 mcp/servers.json 中配置。
AI_PET_MCP_ENABLED=true

# MCP 连接超时时间，单位秒。
AI_PET_MCP_CONNECT_TIMEOUT=15

# MCP 清理/关闭超时时间，单位秒。
AI_PET_MCP_CLEANUP_TIMEOUT=15

# 阿里云 DashScope / 百炼 API Key。
# mcp/servers.json 可通过 api_key_env: "DASHSCOPE_API_KEY" 引用这里的值。
DASHSCOPE_API_KEY=


# =============================================================================
# 3. Python Agent 服务
# =============================================================================

# Python FastAPI 后端监听地址。
# 本地开发建议保持 127.0.0.1。
AI_PET_AGENT_HOST=127.0.0.1

# Python FastAPI 后端端口。
# 如果 8787 被占用，可以改成其它端口，同时确保 Electron 客户端读取到同一配置。
AI_PET_AGENT_PORT=8787


# =============================================================================
# 4. SDK Session 短期上下文
# =============================================================================

# 当前桌宠会话 ID。
# 同一个 session_id 会复用同一段短期对话历史。
AI_PET_SESSION_ID=desktop-active

# SDK session SQLite 数据库路径。
# 留空时使用默认路径；也可以填项目内路径，例如：
# AI_PET_SESSION_DB_PATH=/Users/you/project/ai-pet/data/agent_sessions.sqlite3
AI_PET_SESSION_DB_PATH=

# 每次请求最多加载多少条 session 历史项。
# 数值越大，上下文越完整，但 token 消耗也越高。
AI_PET_SESSION_CONTEXT_LIMIT=40


# =============================================================================
# 5. Markdown 长期记忆与 Skill
# =============================================================================

# 是否启用长期记忆系统。
AI_PET_MEMORY_ENABLED=true

# 是否启用后台自动捕获偏好/长期记忆。
# true：模型会在合适场景下自动沉淀用户偏好。
# false：只在显式记忆/忘记时更新。
AI_PET_MEMORY_AUTO_CAPTURE=true

# 长期记忆与 skill 的根目录。
# 留空时使用默认 data/memory。
AI_PET_MEMORY_DIR=


# =============================================================================
# 6. 记忆注入限制
# =============================================================================
# 这些限制控制“每次请求最多注入多少字符到模型上下文”。
# 调大可以让模型看到更多记忆，调小可以节省 token。

# 核心长期记忆注入字符上限。
AI_PET_MEMORY_CORE_CHAR_LIMIT=3000

# 当前模式记忆注入字符上限。
AI_PET_MEMORY_MODE_CHAR_LIMIT=2500

# skill 索引注入字符上限。
AI_PET_SKILL_INDEX_CHAR_LIMIT=2000

# 单个匹配 skill 文件注入字符上限。
AI_PET_SKILL_FILE_CHAR_LIMIT=5000

# 每次请求最多注入几个匹配 skill。
AI_PET_MAX_SKILLS_PER_REQUEST=2


# =============================================================================
# 7. 记忆与 Skill 文件存储限制
# =============================================================================
# 这些限制控制“磁盘上的 Markdown 文件最多保留多少字符”。

# 核心长期记忆文件最大字符数。
AI_PET_MEMORY_CORE_FILE_MAX_CHARS=12000

# 模式记忆文件最大字符数。
AI_PET_MEMORY_MODE_FILE_MAX_CHARS=10000

# 单个 skill 文件最大字符数。
AI_PET_SKILL_FILE_MAX_CHARS=14000

# skill 索引文件最大字符数。
AI_PET_SKILL_INDEX_FILE_MAX_CHARS=12000


# =============================================================================
# 8. 本地知识库
# =============================================================================

# 是否启用本地知识库。
AI_PET_KB_ENABLED=true

# 知识库根目录。
# 留空时使用项目内默认 knowledge 目录。
AI_PET_KB_DIR=

# 转换后文档目录。
# 留空时使用知识库根目录下的 documents。
AI_PET_KB_DOCUMENT_DIR=

# 知识库索引 SQLite 路径。
# 留空时使用知识库根目录下的 index/knowledge.sqlite3。
AI_PET_KB_INDEX_DB_PATH=

# 每次知识检索返回的候选片段数量。
AI_PET_KB_TOP_K=5

# 注入模型的知识库上下文最大字符数。
AI_PET_KB_MAX_CONTEXT_CHARS=6000

# 文档切片最大字符数。
AI_PET_KB_CHUNK_MAX_CHARS=1400

# 查询知识库时，如果索引为空或失败，是否自动触发导入。
AI_PET_KB_AUTO_IMPORT_ON_QUERY=true

# Python 后端启动时是否自动导入/索引知识库。
AI_PET_KB_IMPORT_ON_STARTUP=true


# =============================================================================
# 9. 知识文件上传与 MarkItDown 转换
# =============================================================================

# 是否启用前端拖拽/上传文件进入知识库。
AI_PET_KB_UPLOAD_ENABLED=true

# 上传原始文件存放目录。
# 留空时使用默认 uploads 目录。
AI_PET_KB_UPLOAD_DIR=

# 转换后文件存放目录。
# 留空时使用默认 converted/uploads 目录。
AI_PET_KB_CONVERTED_DIR=

# 单个上传文件最大大小，单位 MB。
AI_PET_KB_UPLOAD_MAX_MB=25

# 允许上传的文件扩展名，逗号分隔。
AI_PET_KB_UPLOAD_ALLOWED_EXTENSIONS=.md,.txt,.pdf,.docx,.pptx,.xlsx,.html,.htm,.csv,.json


# =============================================================================
# 10. 知识库向量检索
# =============================================================================

# 是否启用 embedding 向量检索。
# 如果没有配置可用 embedding 服务，可以改为 false，仅使用关键词/图谱检索。
AI_PET_KB_EMBEDDING_ENABLED=true

# embedding 模型名。
# 阿里云示例：text-embedding-v3
# OpenAI 示例：text-embedding-3-small
AI_PET_KB_EMBEDDING_MODEL=text-embedding-v3

# embedding 服务 API Key。
# 留空时通常复用 OPENAI_API_KEY。
AI_PET_KB_EMBEDDING_API_KEY=

# embedding 服务 Base URL。
# 留空时通常复用 OPENAI_BASE_URL。
AI_PET_KB_EMBEDDING_BASE_URL=

# embedding 维度。
# 不确定时留空，让服务使用默认维度。
AI_PET_KB_EMBEDDING_DIMENSIONS=

# 向量分数权重。
# 和关键词权重一起决定混合检索排序。
AI_PET_KB_VECTOR_WEIGHT=0.55

# 关键词分数权重。
AI_PET_KB_KEYWORD_WEIGHT=0.45


# =============================================================================
# 11. 知识图谱检索
# =============================================================================

# 是否启用规则型知识图谱关系抽取与检索。
AI_PET_KB_GRAPH_ENABLED=true

# 每个文档切片最多抽取多少条关系。
AI_PET_KB_GRAPH_MAX_RELATIONS_PER_CHUNK=8

# 图谱检索分数权重。
AI_PET_KB_GRAPH_WEIGHT=0.20

# 注入模型的图谱上下文最大字符数。
AI_PET_KB_GRAPH_CONTEXT_LIMIT=2000


# =============================================================================
# 12. 知识图谱 LLM 抽取
# =============================================================================

# 是否启用 LLM 辅助抽取实体和关系。
# false：只使用规则抽取，成本低、稳定。
# true：调用模型抽取，效果可能更好，但会消耗模型额度。
AI_PET_KB_GRAPH_LLM_ENABLED=false

# 图谱抽取策略。
# rule：只用规则。
# llm：只用 LLM。
# hybrid：规则 + LLM 混合。
AI_PET_KB_GRAPH_EXTRACTOR=hybrid

# 图谱抽取使用的 LLM 模型名。
# 留空时可由代码选择默认或复用主模型配置。
AI_PET_KB_GRAPH_LLM_MODEL=

# 图谱抽取 LLM API Key。
# 留空时通常复用主模型 API Key。
AI_PET_KB_GRAPH_LLM_API_KEY=

# 图谱抽取 LLM Base URL。
# 留空时通常复用主模型 Base URL。
AI_PET_KB_GRAPH_LLM_BASE_URL=

# 每个切片最多抽取多少个实体。
AI_PET_KB_GRAPH_LLM_MAX_ENTITIES_PER_CHUNK=30

# 每个切片最多抽取多少条关系。
AI_PET_KB_GRAPH_LLM_MAX_RELATIONS_PER_CHUNK=20

# LLM 抽取关系的最低置信度。
AI_PET_KB_GRAPH_LLM_MIN_CONFIDENCE=0.65

# 每次送给 LLM 抽取的最大字符数。
AI_PET_KB_GRAPH_LLM_MAX_CHARS=3000

# LLM 抽取失败时是否回退到规则抽取。
AI_PET_KB_GRAPH_LLM_FALLBACK_TO_RULE=true


# =============================================================================
# 13. 全局文档摘要
# =============================================================================

# 是否启用文档摘要能力。
AI_PET_KB_SUMMARY_ENABLED=true

# 是否用 LLM 生成摘要。
# false：使用轻量/规则摘要。
# true：调用模型生成摘要，会消耗模型额度。
AI_PET_KB_SUMMARY_LLM_ENABLED=false

# 摘要模型名。
# 留空时通常复用主模型或默认摘要模型。
AI_PET_KB_SUMMARY_MODEL=

# 摘要模型 API Key。
# 留空时通常复用主模型 API Key。
AI_PET_KB_SUMMARY_API_KEY=

# 摘要模型 Base URL。
# 留空时通常复用主模型 Base URL。
AI_PET_KB_SUMMARY_BASE_URL=

# 生成摘要时输入文本最大字符数。
AI_PET_KB_SUMMARY_MAX_CHARS=6000

# 导入文档时是否同步生成摘要。
AI_PET_KB_SUMMARY_ON_IMPORT=true

# 是否为摘要生成 embedding，用于摘要级检索。
AI_PET_KB_SUMMARY_EMBEDDING_ENABLED=true
