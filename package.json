{
  "name": "ai-pet",
  "version": "0.1.0",
  "description": "Minimal desktop pet shell with a Python OpenAI Agents backend",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "npm run clean:dist && npm run clean:release",
    "clean:dist": "node scripts/clean.mjs dist",
    "clean:release": "node scripts/clean.mjs release",
    "dev": "npm run dev:desktop",
    "dev:desktop": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "node scripts/dev-main.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:python": "node scripts/dev-python.mjs",
    "build": "npm run clean:dist && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "package": "npm run build && electron-builder --mac --win --linux"
  },
  "keywords": [
    "ai",
    "desktop-pet",
    "agent",
    "electron",
    "fastapi"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.aipet.desktop",
    "productName": "AI Pet",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
