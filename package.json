{
  "name": "ai-pet",
  "version": "0.1.0",
  "description": "AI Desktop Pet - Personal Agent with Knowledge Base",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:tools": "OPEN_DEVTOOLS=1 npm run dev",
    "dev:main": "sh -c 'sleep 3 && NODE_ENV=development tsc -p tsconfig.main.json && NODE_ENV=development electron .'",
    "dev:renderer": "NODE_ENV=development vite --host 127.0.0.1",
    "dev:python": "python3 -m uvicorn python.main:app --host 127.0.0.1 --port 8787",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "package": "electron-builder --mac --win --linux",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "ai",
    "desktop-pet",
    "agent",
    "mcp",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "langchain": "^0.1.0",
    "openai": "^4.28.0",
    "pixi.js": "^7.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.aipet.desktop",
    "productName": "AI Pet",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
